# =============================================================================
# poc_dbt configuration through environment variables.
#
#   1. Copy to .env and fill in (.env is never pushed to the repository).
#   2. Load it into the shell before using dbt (see README):
#        bash:        set -a; . ./.env; set +a
#        PowerShell:  Get-Content .env | Where-Object { $_ -match '^[A-Z_]+=' } |
#                       ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }
#
# Only the variables of the warehouse chosen in DBT_ADAPTER are needed.
# Optional ones are commented out: a variable that is defined but empty does NOT
# use the env_var() default, it uses the empty string.
# In Cloud Build values come from the substitutions in cloudbuild.yaml, and in
# Composer/Airflow from the environment variables of the environment.
# =============================================================================

# --- Repository ---------------------------------------------------------------
# URL of the project's git repository (to be created).
DBT_GIT_REPO_URL=

# --- dbt ----------------------------------------------------------------------
# Warehouse: bigquery | snowflake | databricks | redshift | postgres | duckdb
# Selects the poc_dbt_<DBT_ADAPTER> profile in profiles.yml. Install
# requirements.txt for BigQuery, requirements/<DBT_ADAPTER>.txt otherwise.
DBT_ADAPTER=bigquery
# Directory of profiles.yml: the project itself.
DBT_PROFILES_DIR=.
# Target: local | ideacion | prod  (and ci, DuckDB only)
DBT_TARGET=local
# User for the suffix of personal schemas outside ideacion/prod
# (ds_gld_use_case_1_<user>). Without it "local" is used and several developers
# would overwrite each other.
DBT_USER=
# Parallel threads.
# DBT_THREADS=4
# Database of the landing tables (sources): project in BigQuery, catalog in
# Databricks, database elsewhere. Defaults to the one of the target.
# DBT_SOURCE_DATABASE=

# --- BigQuery (DBT_ADAPTER=bigquery) -----------------------------------------
# Authentication: gcloud auth application-default login (or Composer's service account).
DBT_BQ_PROJECT=
DBT_BQ_LOCATION=europe-southwest1
# DBT_BQ_IMPERSONATE_SERVICE_ACCOUNT=dbt-runner@<project>.iam.gserviceaccount.com
# Bytes billed limit per query on the local target (100 GB by default).
# DBT_BQ_MAXIMUM_BYTES_BILLED=100000000000

# --- Snowflake (DBT_ADAPTER=snowflake) ---------------------------------------
# Authentication: SSO (externalbrowser) locally; key pair in ideacion/prod.
# DBT_SNOWFLAKE_ACCOUNT=
# DBT_SNOWFLAKE_USER=
# DBT_SNOWFLAKE_ROLE=
# DBT_SNOWFLAKE_WAREHOUSE=
# DBT_SNOWFLAKE_DATABASE=
# DBT_SNOWFLAKE_PRIVATE_KEY_PATH=

# --- Databricks (DBT_ADAPTER=databricks) -------------------------------------
# Required even for dbt parse (the adapter validates the host format).
# DBT_DATABRICKS_HOST=<workspace>.cloud.databricks.com
# DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
# DBT_DATABRICKS_TOKEN=
# DBT_DATABRICKS_CATALOG=

# --- Redshift (DBT_ADAPTER=redshift) -----------------------------------------
# DBT_REDSHIFT_HOST=
# DBT_REDSHIFT_PORT=5439
# DBT_REDSHIFT_USER=
# DBT_REDSHIFT_PASSWORD=
# DBT_REDSHIFT_DBNAME=

# --- Postgres (DBT_ADAPTER=postgres) -----------------------------------------
# DBT_POSTGRES_HOST=localhost
# DBT_POSTGRES_PORT=5432
# DBT_POSTGRES_USER=
# DBT_POSTGRES_PASSWORD=
# DBT_POSTGRES_DBNAME=

# --- DuckDB (DBT_ADAPTER=duckdb) ---------------------------------------------
# Local database file. poc_dbt.duckdb by default (target_ci/ci.duckdb on ci).
# DBT_DUCKDB_PATH=poc_dbt.duckdb

# --- Deployment (Cloud Build -> Composer bucket) -------------------------------
# Informational only locally: Cloud Build uses its substitutions (_DBT_GCS_BUCKET...).
DBT_GCS_BUCKET=europe-southwest1-aaaa-bucket
DBT_GCS_PATH=dags/dbt
