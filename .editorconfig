# Same formatting in every editor (https://editorconfig.org), consistent with
# .gitattributes (LF in the repository) and .sqlfluff (4-space SQL, 120 columns).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.sql]
max_line_length = 120

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
